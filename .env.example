# Host ports agreed by the team
GATEWAY_PORT=8080
EUREKA_PORT=8761

USER_SERVICE_PORT=8081
USER_DB_NAME=user_db
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres_password
USER_DB_PORT=5433

DRIVER_SERVICE_PORT_1=8082
DRIVER_DB_NAME=driver_db
DRIVER_DB_USER=postgres
DRIVER_DB_PASSWORD=postgres_password
DRIVER_DB_PORT=5434

TRIP_SERVICE_PORT=8083
TRIP_DB_NAME=trip_db
TRIP_DB_USER=postgres
TRIP_DB_PASSWORD=postgres_password
TRIP_DB_PORT=5435

MATCHING_SERVICE_PORT=8084
MATCHING_DB_NAME=matching_db
MATCHING_DB_USER=postgres
MATCHING_DB_PASSWORD=postgres_password
MATCHING_DB_PORT=5436

PAYMENT_SERVICE_PORT=8085
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=postgres
PAYMENT_DB_PASSWORD=postgres_password
PAYMENT_DB_PORT=5437

NOTIFICATION_SERVICE_PORT=8086
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=postgres
NOTIFICATION_DB_PASSWORD=postgres_password
NOTIFICATION_DB_PORT=5438

# Optional second driver instance (--profile scale)
DRIVER_SERVICE_PORT_2=18082

REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Doi mat khau nay neu mo Grafana ra ngoai may ca nhan
GRAFANA_ADMIN_PASSWORD=admin
RABBITMQ_MANAGEMENT_PORT=15672
EUREKA_HOST=eureka_server
# Generate a random secret (at least 64 bytes) and set it in your local .env.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Dynamic pricing: server-side keys, enable the corresponding Google APIs.
# With no Routes key, quotes explicitly use straight-line distance + estimated time.
GOOGLE_ROUTES_API_KEY=
GOOGLE_WEATHER_API_KEY=
# For Node Trip running on the host; Docker Compose sets its own internal URL.
REDIS_URL=redis://127.0.0.1:6379
