# Copy to .env and change for your machine. .env is git-ignored.

# RabbitMQ (shared by all services)
RABBITMQ_USER=rideflow
RABBITMQ_PASSWORD=rideflow_pass

# Payment Service -> payment_db (user payment_svc)
PAYMENT_DB_PASSWORD=payment_pass

# Notification Service -> notification_db (user notification_svc)
NOTIFICATION_DB_PASSWORD=notification_pass
