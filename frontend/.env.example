# Địa chỉ API Gateway mà server Next.js chuyển tiếp request /gw/... tới
GATEWAY_URL=http://localhost:8080

# Google Maps Platform: bật Maps JavaScript API, Places API (New), Geocoding API, Routes API cho key này
# và giới hạn key theo HTTP referrer (vd: http://localhost:3001/*). Không commit key thật.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID cho Advanced Marker; để trống sẽ dùng DEMO_MAP_ID của Google (chỉ để phát triển)
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Các trang quản trị hiển thị ở mục Tổng quan
NEXT_PUBLIC_EUREKA_URL=http://localhost:8761
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000
NEXT_PUBLIC_ZIPKIN_URL=http://localhost:9411
NEXT_PUBLIC_RABBITMQ_URL=http://localhost:15672
