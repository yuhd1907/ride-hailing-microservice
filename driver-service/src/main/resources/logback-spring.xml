<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="driver-service"/>
    <springProperty scope="context" name="instanceId" source="eureka.instance.instance-id" defaultValue="driver-service"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.ridehail.driverservice.logging.JsonLogEncoder">
            <serviceName>${appName}</serviceName>
            <instanceId>${instanceId}</instanceId>
        </encoder>
    </appender>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${appName}-${instanceId}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/${appName}-${instanceId}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder class="com.ridehail.driverservice.logging.JsonLogEncoder">
            <serviceName>${appName}</serviceName>
            <instanceId>${instanceId}</instanceId>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>

    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="com.ridehail" level="INFO"/>
</configuration>
